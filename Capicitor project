# 1. Create frontend project (Vite + vanilla JS)
npm create vite@latest my-music-app -- --template vanilla
cd my-music-app
npm install

# 2. Install Capacitor core
npm install @capacitor/core @capacitor/cli

# 3. Initialize Capacitor
npx cap init "My Music" com.example.mymusic --web-dir=dist

# 4. Add Android platform
npm install @capacitor/android
npx cap add android

# 5. Install folder picker plugin
npm install capacitor-folder-picker

# 6. Sync to native project
npx cap sync
